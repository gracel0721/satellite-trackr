# Files excluded from the Vercel deployment. The Vercel build is a static
# frontend (served from `frontend/`) plus one serverless function (api/config.py)
# that reads the GCS data URL from env. Everything below is for local dev, the
# GCP Cloud Function, or the pipeline — not needed (and not wanted) on Vercel.

# Local virtualenv + caches
.venv
__pycache__
**/__pycache__

# GCP infra + Cloud Function entry (managed by Terraform, not Vercel)
infra
main.py
config.py
pipeline

# Generated data — the Vercel frontend reads positions.json from GCS, not the repo
data

# FastAPI app is for local dev only; exclude so Vercel does not auto-detect it as
# a function entrypoint (it defines `app` and would otherwise be deployed).
api/main.py
api/__init__.py

# Misc
.github
plans
README.md
.gitignore
.vercelignore